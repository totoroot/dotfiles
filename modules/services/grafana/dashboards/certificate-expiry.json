{
  "uid": "lHnsYlPGk",
  "title": "Certificates Expiration (HTTPS Probes)",
  "description": "Certificate expiry for HTTPS endpoints probed by Blackbox Exporter. Shows the earliest expiry in the certificate chain observed by each probe, not certificates on disk or in Kubernetes secrets.",
  "schemaVersion": 42,
  "tags": ["certificates", "tls", "blackbox"],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "2m",
  "links": [
    {"type": "link", "title": "Blackbox Exporter", "url": "/d/pS6ZuGV7z/blackbox-exporter", "keepTime": true}
  ],
  "panels": [
    {
      "id": 1,
      "title": "Days until expiry by endpoint",
      "description": "Sorted by soonest expiry. Negative values mean expired. This table covers every HTTPS probe with TLS expiry data, not just the targets selected for alerting.",
      "type": "table",
      "gridPos": {"x": 0, "y": 0, "w": 16, "h": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A", "format": "table", "instant": true, "range": false,
          "expr": "(min by (target) (probe_ssl_earliest_cert_expiry{job=\"blackbox\",target=~\"https://.+\"}) - time()) / 86400"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"target": "Endpoint", "Value": "Days remaining", "Value #A": "Days remaining"}}}
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Days remaining"},
            "properties": [
              {"id": "decimals", "value": 1},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 7}, {"color": "green", "value": 21}]}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "Days remaining", "desc": false}]}
    },
    {
      "id": 2,
      "title": "HTTPS probes without expiry data",
      "description": "Configured HTTPS targets with no current TLS expiry sample. An empty table means no missing data among targets known to Prometheus, provided the Blackbox scrape job is configured and available.",
      "type": "table",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A", "format": "table", "instant": true, "range": false,
          "expr": "min by (target) (up{job=\"blackbox\",target=~\"https://.+\"} unless on (target) probe_ssl_earliest_cert_expiry{job=\"blackbox\"})"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"target": "Endpoint", "Value": "Status", "Value #A": "Status"}}}
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Scrape failed", "color": "red"}, "1": {"text": "No TLS expiry reported", "color": "orange"}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "options": {"showHeader": true}
    }
  ]
}
