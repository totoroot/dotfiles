#!/usr/bin/env bash
set +x
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: provision-host-secret --apply {jam|teal} SOPS_KEY VAULT_ITEM_ID' \
    '       provision-host-secret --curl-url {jam|teal} SOPS_KEY VAULT_ITEM_ID' \
    '       provision-host-secret --dry-run {jam|teal} VAULT_ITEM_ID' >&2
  exit 2
}

mode=${1:-}
case "$mode:$#" in
  --dry-run:3) item=$3 ;;
  --apply:4|--curl-url:4) key=$3; item=$4 ;;
  *) usage ;;
esac
host=$2
repo=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ! "$item" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
  echo 'Use a Vaultwarden item UUID.' >&2
  exit 2
fi

# Public recipients from the respective repositories' .sops.yaml files.
case "$host" in
  jam)
    recipient=age182t5p08xxdq72lxaxr66txspete3wahnlcfv96vq7svgl395g4lsusc8ut
    identity=/var/lib/sops-nix/jam.txt
    checkout=$repo
    nixpkgs_input=nixos
    ;;
  teal)
    recipient=age1qujdzjtvmrws9n9xwu7j2e6xms59elndz9trr0q62qg9ekh2cqsqlk23t0
    identity=/var/lib/sops-nix/teal
    checkout=${TEAL_ENVIRONMENTS_DIR:-$HOME/Development/private/thym.it/platform/environments}
    nixpkgs_input=nixpkgs
    ;;
  *) echo 'Unsupported host. Choose jam or teal.' >&2; exit 2 ;;
esac

if [[ $mode != --dry-run ]]; then
  [[ $key =~ ^[a-zA-Z0-9_-]+$ && $key != sops ]] || usage
  yaml_dir=$(cd -P -- "$checkout/secrets" && pwd)
  yaml=$yaml_dir/$host.yaml
  [[ -f $yaml && ! -L $yaml ]] || { echo "Expected an existing regular file: $yaml" >&2; exit 1; }
fi

if [[ ! -t 0 ]]; then
  echo 'Run interactively so Vaultwarden and remote sudo can prompt.' >&2
  exit 1
fi
for tool in bw jq age ssh scp; do
  if ! command -v "$tool" >/dev/null; then
    if [[ ${PROVISION_SECRET_IN_NIX:-} != 1 ]] && command -v nix >/dev/null; then
      export PROVISION_SECRET_IN_NIX=1
      exec nix develop "$repo#secrets" --command "$repo/bin/provision-host-secret" "$@"
    fi
    echo "Missing $tool. Run from nix develop .#secrets." >&2
    exit 1
  fi
done

ssh_options=(-o ControlPath=none -o StrictHostKeyChecking=yes)
if [[ $mode != --dry-run ]]; then
  umask 077
  local_tmp=$(mktemp -d "$yaml_dir/.provision-secret.XXXXXXXX")
  remote_tmp=
  cleanup() {
    if [[ -n $remote_tmp ]]; then
      # The validated remote staging path is intentionally expanded here.
      # shellcheck disable=SC2029
      ssh "${ssh_options[@]}" "$host" "rm -f -- '$remote_tmp/host.yaml' '$remote_tmp/payload.age' '$remote_tmp/apply.sh' && rmdir -- '$remote_tmp'" </dev/null ||
        echo "Could not clean up encrypted staging files at $host:$remote_tmp" >&2
    fi
    rm -f -- "$local_tmp/original.yaml" "$local_tmp/updated.yaml" "$local_tmp/payload.age" "$local_tmp/apply.sh"
    rmdir -- "$local_tmp"
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  cp -p -- "$yaml" "$local_tmp/original.yaml"
  printf 'Add %s to %s, using %s to decrypt and update it? [y/N] ' "$key" "$yaml" "$host" >&2
  read -r answer
  [[ $answer == y || $answer == Y ]] || exit 1
fi

(
  unset BW_SESSION
  server=https://passwort.xn--berwachungsbehr-mtb1g.de
  if ! bw status | jq -e --arg server "$server" \
    '(.serverUrl | rtrimstr("/")) == $server and .status != "unauthenticated"' >/dev/null; then
    echo "Log the Bitwarden CLI into $server before running this check." >&2
    exit 1
  fi
  lock() {
    if ! bw lock >/dev/null; then
      echo 'Could not lock Bitwarden CLI. Run bw lock manually.' >&2
      return 1
    fi
  }
  trap lock EXIT
  BW_SESSION=$(bw unlock --raw)
  [[ -n "$BW_SESSION" ]]
  export BW_SESSION
  if ! bw sync >/dev/null 2>&1; then
    echo 'Could not refresh the local Vaultwarden cache. No files were changed.' >&2
    exit 1
  fi
  if [[ $mode != --dry-run ]]; then
    # Keep the vault value out of argv, the environment, and plaintext files.
    if ! (
      bw get item "$item" 2>/dev/null |
        jq -ce --arg id "$item" --arg mode "$mode" '
          select(.id == $id) |
          (if .type == 1 then .login.password elif .type == 2 then .notes else null end) |
          strings | select(length > 0) |
          if $mode == "--curl-url" then
            sub("^[[:space:]]+"; "") | sub("[[:space:]]+$"; "") |
            select(test("^https://hc-ping[.]com/[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")) |
            "url = " + @json + "\n"
          else . end
        ' 2>/dev/null | age --recipient "$recipient" >"$local_tmp/payload.age" 2>/dev/null
      stages=("${PIPESTATUS[@]}")
      if (( stages[0] != 0 )); then
        echo 'Vaultwarden could not read that item after sync. Check the item UUID and collection access.' >&2
        exit 1
      elif (( stages[2] != 0 )); then
        echo 'Could not encrypt the payload to the selected host.' >&2
        exit 1
      elif (( stages[1] != 0 )); then
        echo 'Item was read, but its value did not pass validation. Use the Login Password or Secure Note contents, not the URI field. Curl URL mode expects the full hc-ping.com Ping URL.' >&2
        exit 1
      fi
    ); then
      exit 1
    fi
  elif ! bw get item "$item" 2>/dev/null | jq -e --arg id "$item" '.id == $id' >/dev/null 2>&1; then
    echo 'Could not read the designated Vaultwarden item.' >&2
    exit 1
  fi
  lock
  trap - EXIT
)
if [[ $mode != --dry-run ]]; then
  candidate=$(ssh "${ssh_options[@]}" "$host" 'mktemp -d /tmp/provision-host-secret.XXXXXXXX')
  [[ $candidate =~ ^/tmp/provision-host-secret\.[[:alnum:]]{8}$ ]] || { echo 'Unexpected remote staging path.' >&2; exit 1; }
  remote_tmp=$candidate
  cat >"$local_tmp/apply.sh" <<'REMOTE'
set -euo pipefail
cd -- "$1"
identity=$2
key=$3
for tool in age sops jq; do
  command -v "$tool" >/dev/null || { echo "Missing $tool on the host." >&2; exit 1; }
done
age_bin=$(command -v age)
sops_bin=$(command -v sops)
# sudo -v can prompt even when command execution is allowed by NOPASSWD.
if ! sudo -n true 2>/dev/null; then sudo -v; fi
if ! sudo -n env SOPS_AGE_KEY_FILE="$identity" "$sops_bin" decrypt --output-type json host.yaml |
  jq -e --arg key "$key" 'type == "object" and (has($key) | not)' >/dev/null; then
  echo 'Could not verify that the key is absent. Existing entries are never overwritten.' >&2
  exit 1
fi
sudo -n "$age_bin" --decrypt --identity "$identity" payload.age |
  sudo -n env SOPS_AGE_KEY_FILE="$identity" "$sops_bin" set --value-stdin host.yaml "[\"$key\"]"
sudo -n chown "$(id -u):$(id -g)" host.yaml
REMOTE
  scp "${ssh_options[@]}" "$local_tmp/original.yaml" "$host:$remote_tmp/host.yaml"
  scp "${ssh_options[@]}" "$local_tmp/payload.age" "$local_tmp/apply.sh" "$host:$remote_tmp/"
  rev=$(jq -er --arg input "$nixpkgs_input" '.nodes as $nodes | $nodes[$nodes.root.inputs[$input]].locked | select((.owner | ascii_downcase) == "nixos" and .repo == "nixpkgs") | .rev | select(test("^[0-9a-f]{40}$"))' "$yaml_dir/../flake.lock")
  remote_apply="bash '$remote_tmp/apply.sh' '$remote_tmp' '$identity' '$key'"
  ssh -t "${ssh_options[@]}" "$host" \
    "if command -v age >/dev/null && command -v sops >/dev/null && command -v jq >/dev/null; then
      $remote_apply
    else
      nix --option accept-flake-config false shell --no-write-lock-file 'github:NixOS/nixpkgs/$rev#age' 'github:NixOS/nixpkgs/$rev#sops' 'github:NixOS/nixpkgs/$rev#jq' -c $remote_apply
    fi"
  scp "${ssh_options[@]}" "$host:$remote_tmp/host.yaml" "$local_tmp/updated.yaml"
  if ! grep -qE "^${key}: ENC\\[" "$local_tmp/updated.yaml" || ! cmp -s "$yaml" "$local_tmp/original.yaml"; then
    echo 'Updated file failed validation or the local YAML changed. The local file was not replaced.' >&2
    exit 1
  fi
  mv -- "$local_tmp/updated.yaml" "$yaml"
  echo "Added encrypted key $key to $yaml. Nothing was committed or deployed."
  exit 0
fi

echo 'Vaultwarden item read verified. No item contents were displayed or sent.'

# No item data is used below. Armor makes the dummy ciphertext safe to pass
# through the SSH command line after rejecting any embedded shell quote.
dummy='provision-host-secret dry-run v1'
ciphertext=$(printf '%s\n' "$dummy" | age --armor --recipient "$recipient")
[[ -n "$ciphertext" && "$ciphertext" != *"'"* ]]
ssh -t -o ControlPath=none -o StrictHostKeyChecking=yes "$host" \
  "age_bin=\$(command -v age) && test -x \"\$age_bin\" || { echo 'Install age on the target first.' >&2; exit 1; }
   (sudo -n true 2>/dev/null || sudo -v) && decoded=\$(printf '%s\n' '$ciphertext' | sudo -n \"\$age_bin\" --decrypt --identity '$identity') && test \"\$decoded\" = '$dummy'"
echo "Encrypted dummy handoff verified for $host. No SOPS files were changed."
