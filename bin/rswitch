#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: rswitch [--host HOST] [--force-host] [ACTION] [-- NIX_ARGS...]' \
    '' \
    '  switch   Register and activate the configuration (default)' \
    '  test     Activate temporarily on NixOS, or run darwin-rebuild check' \
    '  boot     Register for the next boot on NixOS only' \
    '  -h, --help  Show this help without building or activating' \
    '' \
    'Use --force-host to permit an explicitly selected host other than this one.' \
    'Arguments after -- are forwarded to nix build or darwin-rebuild.' \
    'Example: rswitch test -- --show-trace'
}

die() {
  printf 'Error: %s\nRun rswitch --help for usage.\n' "$1" >&2
  exit 1
}

host="$(hostname)"
flake_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target_host="$host"
force_host=0
action=""
nix_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --host)
      [[ -n ${2:-} && $2 != -* ]] || die '--host requires a value'
      shift
      target_host="$1"
      ;;
    --force-host)
      force_host=1
      ;;
    switch|test|boot)
      [[ -z $action ]] || die "unexpected second action: $1"
      action="$1"
      ;;
    --)
      shift
      nix_args=("$@")
      break
      ;;
    *)
      die "unexpected argument: $1 (put Nix arguments after --)"
      ;;
  esac
  shift
done

action=${action:-switch}

if [[ $force_host -ne 1 && "$target_host" != "$host" ]]; then
  echo "Refusing to rebuild: host is $host (expected $target_host)." >&2
  echo "Use --force-host to override." >&2
  exit 1
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
  darwin_action="$action"
  case "$action" in
    switch)
      darwin_action="switch"
      ;;
    test)
      darwin_action="check"
      ;;
    boot)
      echo "Darwin does not support 'boot' via darwin-rebuild." >&2
      exit 1
      ;;
  esac

  darwin_rebuild="${flake_root}#darwinConfigurations.${target_host}.config.system.build.darwin-rebuild"
  exec sudo -H nix run --no-update-lock-file "$darwin_rebuild" -- \
    "$darwin_action" --flake "${flake_root}#${target_host}" --impure ${nix_args[@]+"${nix_args[@]}"}
fi

build_attr="${flake_root}#nixosConfigurations.${target_host}.config.system.build.toplevel"

# Build the configuration. Do not attempt activation when the build fails;
# otherwise an empty store_path produces the misleading /bin/switch-to-configuration
# error instead of preserving the actual evaluation/build failure.
if ! store_path=$(sudo nix build "$build_attr" --impure --print-out-paths --no-link ${nix_args[@]+"${nix_args[@]}"}); then
  echo "Error: failed to build $build_attr; refusing to activate." >&2
  exit 1
fi

if [[ -z "$store_path" ]]; then
  echo "Error: nix build returned no store path; refusing to activate." >&2
  exit 1
fi

if [[ ! -x "$store_path/bin/switch-to-configuration" ]]; then
  echo "Error: build output has no executable switch-to-configuration; refusing to activate." >&2
  exit 1
fi

# The bootloader enumerates the system profile's generations. Register the
# closure before activation so switch and boot can install the new boot entry.
# Unlike switch and boot, test must not change the persistent system profile.
if [[ "$action" != "test" ]]; then
  sudo nix-env --profile /nix/var/nix/profiles/system --set "$store_path"
fi

exec sudo "$store_path/bin/switch-to-configuration" "$action"
