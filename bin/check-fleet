#!/usr/bin/env bash
set -euo pipefail

# Only active hosts in hosts/registry.nix gate changes.
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
status=0

check() {
  local host=$1 attr=$2 result
  if result=$(nix eval --no-update-lock-file --raw "$root#$attr"); then
    printf 'PASS  %s  %s\n' "$host" "$result"
  else
    printf 'FAIL  %s\n' "$host" >&2
    status=1
  fi
}

targets=$(nix eval --raw --file "$root/hosts/registry.nix" --apply 'hosts:
  let
    targetsFor = group: suffix: builtins.concatStringsSep "" (
      builtins.map (name:
        if hosts.${group}.${name}.active then "${name} ${group}.${name}.${suffix}\n" else ""
      ) (builtins.attrNames hosts.${group})
    );
  in targetsFor "nixosConfigurations" "config.system.build.toplevel.drvPath"
    + targetsFor "darwinConfigurations" "system.drvPath"
')
if [[ -z $targets ]]; then
  echo 'No active hosts in hosts/registry.nix' >&2
  exit 1
fi
while read -r host attr; do
  [[ -n $host ]] || continue
  check "$host" "$attr"
done <<< "$targets"

exit "$status"
